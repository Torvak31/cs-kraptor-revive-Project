import os
import json
import hashlib

files = [f for f in os.listdir('.') if f.endswith('.cs3')]
plugins = []

for f in files:
    size = os.path.getsize(f)
    plugins.append({
        "name": f.replace('.cs3', ''),
        "description": f"CloudStream plugin: {f.replace('.cs3', '')}",
        "authors": "Torvak31(Eknux)",
        "status": 1,
        "tvTypes": "Movie|TV Series|Animation",
        "language": "tr",
        "iconUrl": "",
        "version": 1,
        "apiVersion": 1,
        "repositoryUrl": "https://github.com/Torvak31/cs-kraptor-revive-Project",
        "url": f"https://raw.githubusercontent.com/Torvak31/cs-kraptor-revive-Project/main/{f}",
        "fileSize": size
    })

with open('plugins.json', 'w', encoding='utf-8') as fp:
    json.dump(plugins, fp, ensure_ascii=False, indent=2)